---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  twitterCard?: string;
  noindex?: boolean;
  hreflang?: string;
  schemaJson?: string;
}

const {
  title = "TheEduAssist - High Quality Education & Resources",
  description = "Empowering learners worldwide with structured resources, industry guides, and high-performance blog insights.",
  canonicalUrl = Astro.url.href,
  ogImage = "/images/default-og.jpg",
  ogType = "website",
  twitterCard = "summary_large_image",
  noindex = false,
  hreflang,
  schemaJson
} = Astro.props;

// Determine robots tag content based on noindex logic
const robotsDirective = noindex ? "noindex, nofollow" : "index, follow";
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    {/* Primary Meta Tags */}
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    {/* Canonical URL */}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    {/* Robots Directive */}
    <meta name="robots" content={robotsDirective} />

    {/* Hreflang support */}
    {hreflang && canonicalUrl && (
      <link rel="alternate" hreflang={hreflang} href={canonicalUrl} />
    )}

    {/* Google Search Console Verification Placeholder */}
    <meta name="google-site-verification" content="PLACEHOLDER_CODE" />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site || Astro.url).href} />

    {/* Twitter */}
    <meta property="twitter:card" content={twitterCard} />
    <meta property="twitter:url" content={Astro.url.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, Astro.site || Astro.url).href} />

    {/* Plus Jakarta Sans Font */}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">

    {/* Schema.org JSON-LD */}
    {schemaJson && (
      <script type="application/ld+json" set:html={schemaJson} />
    )}
  </head>
  <body class="bg-[#fafbfd] text-slate-900 font-sans antialiased min-height-screen flex flex-col selection:bg-brand-500 selection:text-white">

    {/* Navigation bar with glassmorphic style */}
    <header class="sticky top-0 z-50 w-full bg-white/80 backdrop-blur-md border-b border-slate-100/80 transition-all duration-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 sm:h-20">

          {/* Logo */}
          <div class="flex-shrink-0">
            <a href="/" class="flex items-center gap-2.5 text-xl font-bold text-slate-950 tracking-tight transition hover:opacity-90">
              <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-gradient-to-tr from-brand-600 to-indigo-500 text-white font-extrabold shadow-sm">
                E
              </span>
              <span>Edu<span class="text-brand-600">Assist</span></span>
            </a>
          </div>

          {/* Desktop Navigation Menu */}
          <nav class="hidden md:flex items-center gap-8 font-medium text-slate-600">
            <a href="/" class="hover:text-brand-600 transition duration-200 py-2">Home</a>
            <a href="/blog" class="hover:text-brand-600 transition duration-200 py-2">Blog</a>
            <a href="/about" class="hover:text-brand-600 transition duration-200 py-2">About</a>
            <a href="/about#contact" class="hover:text-brand-600 transition duration-200 py-2">Contact</a>
          </nav>

          {/* Actions Button */}
          <div class="hidden md:flex items-center gap-4">
            <a
              href="/blog"
              class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl text-sm font-semibold bg-brand-600 hover:bg-brand-700 text-white transition-all duration-200 shadow-md hover:shadow-lg shadow-brand-500/10 hover:shadow-brand-500/20 hover:-translate-y-0.5 active:translate-y-0"
            >
              Read Blog Posts
            </a>
          </div>

          {/* Mobile hamburger menu toggle */}
          <div class="flex md:hidden">
            <button
              id="mobile-menu-toggle"
              type="button"
              class="inline-flex items-center justify-center p-2 rounded-xl text-slate-500 hover:text-slate-900 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-brand-500"
              aria-controls="mobile-menu"
              aria-expanded="false"
              aria-label="Toggle main menu"
            >
              <svg class="h-6 w-6" stroke="currentColor" fill="none" viewBox="0 0 24 24">
                <path id="menu-icon-open" class="inline-flex" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

        </div>
      </div>

      {/* Mobile Navigation Panel */}
      <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-slate-100 transition duration-200">
        <div class="px-4 pt-2 pb-6 space-y-2">
          <a href="/" class="block px-4 py-3 rounded-xl text-base font-medium text-slate-700 hover:bg-slate-50 hover:text-brand-600 transition">Home</a>
          <a href="/blog" class="block px-4 py-3 rounded-xl text-base font-medium text-slate-700 hover:bg-slate-50 hover:text-brand-600 transition">Blog</a>
          <a href="/about" class="block px-4 py-3 rounded-xl text-base font-medium text-slate-700 hover:bg-slate-50 hover:text-brand-600 transition">About</a>
          <a href="/about#contact" class="block px-4 py-3 rounded-xl text-base font-medium text-slate-700 hover:bg-slate-50 hover:text-brand-600 transition">Contact</a>
          <div class="pt-4 px-4">
            <a
              href="/blog"
              class="w-full inline-flex items-center justify-center px-5 py-3 rounded-xl text-sm font-semibold bg-brand-600 text-white shadow-md hover:bg-brand-700 transition"
            >
              Read Blog Posts
            </a>
          </div>
        </div>
      </div>
    </header>

    {/* Main content wrapper */}
    <main class="flex-grow">
      <slot />
    </main>

    {/* Elegant Modern Footer */}
    <footer class="bg-slate-950 text-slate-400 py-16 mt-auto border-t border-slate-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12">

          {/* Logo & Pitch */}
          <div class="md:col-span-2 space-y-6">
            <a href="/" class="flex items-center gap-2.5 text-xl font-bold text-white tracking-tight">
              <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-gradient-to-tr from-brand-500 to-indigo-500 text-white font-extrabold shadow-sm">
                E
              </span>
              <span>Edu<span class="text-brand-400">Assist</span></span>
            </a>
            <p class="text-sm max-w-sm text-slate-400 leading-relaxed">
              Premium content, learning tracks, and guides designed to scale your technical knowledge. Crafted by professionals, managed via headless CMS.
            </p>
            <div class="flex items-center gap-4">
              {/* Social icons */}
              <a href="#" class="text-slate-500 hover:text-white transition" aria-label="Twitter">
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <a href="#" class="text-slate-500 hover:text-white transition" aria-label="GitHub">
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.483 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.137 20.162 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
              </a>
            </div>
          </div>

          {/* Quick Links */}
          <div class="space-y-4">
            <h3 class="text-sm font-semibold text-white uppercase tracking-wider">Resources</h3>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/" class="hover:text-white transition">Home</a></li>
              <li><a href="/blog" class="hover:text-white transition">Blog Feed</a></li>
              <li><a href="/about" class="hover:text-white transition">About Us</a></li>
              <li><a href="/sitemap.xml" class="hover:text-white transition">Sitemap</a></li>
            </ul>
          </div>

          {/* Contact / Newsletter */}
          <div class="space-y-4">
            <h3 class="text-sm font-semibold text-white uppercase tracking-wider">Stay Updated</h3>
            <p class="text-sm text-slate-400 leading-relaxed">
              Join our mailing list to receive hand-crafted tech newsletters and product updates.
            </p>
            <form class="flex flex-col sm:flex-row gap-2 mt-4" onsubmit="event.preventDefault(); alert('Subscribed successfully!');">
              <input
                type="email"
                placeholder="you@example.com"
                required
                class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500 text-white text-sm"
              />
              <button
                type="submit"
                class="inline-flex items-center justify-center px-4 py-2.5 rounded-xl text-sm font-semibold bg-brand-600 hover:bg-brand-700 text-white transition-all duration-200"
              >
                Join
              </button>
            </form>
          </div>

        </div>

        <div class="border-t border-slate-900 mt-12 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-500">
          <p>&copy; {new Date().getFullYear()} TheEduAssist. All rights reserved.</p>
          <div class="flex gap-6">
            <a href="#" class="hover:text-slate-300">Privacy Policy</a>
            <a href="#" class="hover:text-slate-300">Terms of Service</a>
          </div>
        </div>
      </div>
    </footer>

    {/* Mobile menu logic */}
    <script>
      const btn = document.getElementById('mobile-menu-toggle');
      const menu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('menu-icon-open');
      const iconClose = document.getElementById('menu-icon-close');

      if (btn && menu && iconOpen && iconClose) {
        btn.addEventListener('click', () => {
          const isExpanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
          menu.classList.toggle('hidden');
          iconOpen.classList.toggle('hidden');
          iconOpen.classList.toggle('inline-flex');
          iconClose.classList.toggle('hidden');
          iconClose.classList.toggle('inline-flex');
        });
      }
    </script>
  </body>
</html>
