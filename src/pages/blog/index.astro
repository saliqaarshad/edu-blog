---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../../utils/blog';

// Fetch all posts from content collections
const posts = await getCollection('posts');

// Default initial sort: newest first
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Collect all unique tags for filter pills
const allTags = Array.from(new Set(posts.flatMap(post => post.data.tags || [])));
---

<Layout 
  title="TheEduAssist Blog | Latest Web Dev & SEO Insights"
  description="Explore our complete collection of technical guides, SaaS frameworks, and SEO benchmarks. Fully optimized and easy to navigate."
>
  {/* Header Section */}
  <section class="py-16 sm:py-24 bg-gradient-to-b from-slate-50 via-slate-50/50 to-transparent">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-brand-100 text-brand-700 uppercase tracking-wider mb-6">
        Knowledge Feed
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-950 tracking-tight mb-6">
        Unlock technical excellence
      </h1>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Thoroughly researched articles, tutorials, and templates about frontend development, technical SEO, and modern content architectures.
      </p>
    </div>
  </section>

  {/* Search, Filter & Sort Bar */}
  <section class="pb-12 bg-transparent relative z-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-100 shadow-soft max-w-5xl mx-auto space-y-6">
        
        {/* Search and Sort Inputs */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="md:col-span-2 relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-slate-400">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </span>
            <input 
              type="text" 
              id="search-input" 
              placeholder="Search by title, description, keywords..." 
              class="w-full pl-11 pr-4 py-3 rounded-2xl bg-slate-50 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:bg-white text-sm shadow-sm transition"
            />
          </div>
          <div>
            <select 
              id="sort-select"
              class="w-full px-4 py-3 rounded-2xl bg-slate-50 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:bg-white text-sm shadow-sm transition"
            >
              <option value="newest">Sort: Newest First</option>
              <option value="oldest">Sort: Oldest First</option>
              <option value="seo">Sort: Highest SEO Score</option>
            </select>
          </div>
        </div>

        {/* Tag Filtering Pills */}
        <div class="space-y-2.5">
          <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block">Filter by tag:</span>
          <div class="flex flex-wrap gap-2">
            <button 
              class="tag-filter-btn px-4 py-1.5 rounded-xl text-xs font-bold bg-brand-600 text-white border border-transparent shadow-sm transition"
              data-tag="all"
            >
              All Tags ({posts.length})
            </button>
            {allTags.map((tag) => (
              <button 
                class="tag-filter-btn px-4 py-1.5 rounded-xl text-xs font-semibold bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200/50 transition"
                data-tag={tag.toLowerCase()}
              >
                {tag}
              </button>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* Blog Grid Section */}
  <section class="pb-24 bg-transparent relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Feed container */}
      <div 
        id="blog-posts-grid" 
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto"
      >
        {sortedPosts.map((post) => {
          const readingTime = getReadingTime(post.body);
          const tagsLower = post.data.tags.map(t => t.toLowerCase()).join(',');
          
          return (
            <article 
              class="blog-card bg-white rounded-3xl overflow-hidden border border-slate-100 shadow-soft hover:shadow-soft-lg transition-all duration-300 flex flex-col h-full"
              data-title={post.data.title.toLowerCase()}
              data-description={post.data.description.toLowerCase()}
              data-tags={tagsLower}
              data-date={post.data.pubDate.getTime()}
              data-score={post.data.seoScore}
            >
              {/* Card Image */}
              <div class="h-52 w-full bg-slate-150 relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/50 to-transparent z-10"></div>
                <div class="absolute inset-0 bg-gradient-to-br from-brand-600/10 to-indigo-600/10"></div>
                {post.data.featuredImage && (
                  <img 
                    src={post.data.featuredImage} 
                    alt={post.data.featuredImageAlt || post.data.title}
                    class="w-full h-full object-cover transform hover:scale-105 transition duration-500"
                    loading="lazy"
                  />
                )}
                
                {/* Score Pill */}
                <div class="absolute top-4 left-4 z-20">
                  <span class="inline-flex items-center px-3 py-1 rounded-xl text-xs font-bold bg-white/90 backdrop-blur text-brand-700 border border-brand-100/50 shadow-sm">
                    SEO Score: {post.data.seoScore}/100
                  </span>
                </div>
              </div>

              {/* Card Body */}
              <div class="p-6 sm:p-8 flex flex-col flex-grow">
                {/* Meta Row */}
                <div class="flex flex-wrap items-center gap-2.5 text-xs text-slate-500 mb-4">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </time>
                  <span>•</span>
                  <span>{readingTime} min read</span>
                </div>

                {/* Title */}
                <h3 class="text-xl font-bold text-slate-950 line-clamp-2 hover:text-brand-600 transition mb-3">
                  <a href={`/blog/${post.slug}`}>{post.data.title}</a>
                </h3>

                {/* Description */}
                <p class="text-sm text-slate-600 line-clamp-3 leading-relaxed mb-6 flex-grow">
                  {post.data.description}
                </p>

                {/* Tags Row */}
                <div class="flex flex-wrap gap-1.5 mb-6">
                  {post.data.tags.map(tag => (
                    <span class="px-2.5 py-1 rounded-lg text-[11px] font-bold bg-slate-50 text-slate-600 border border-slate-100 uppercase tracking-wider">
                      {tag}
                    </span>
                  ))}
                </div>

                {/* Card Footer */}
                <div class="flex items-center justify-between pt-5 border-t border-slate-50 mt-auto">
                  <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-full bg-slate-100 text-slate-700 flex items-center justify-center font-bold text-xs uppercase">
                      {post.data.author.charAt(0)}
                    </div>
                    <span class="text-xs font-bold text-slate-700">By {post.data.author}</span>
                  </div>
                  <a 
                    href={`/blog/${post.slug}`} 
                    class="inline-flex items-center gap-1 text-xs font-bold bg-brand-50 hover:bg-brand-100 text-brand-700 px-3 py-2 rounded-xl transition"
                  >
                    View Article
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      {/* Empty State */}
      <div 
        id="empty-state" 
        class="hidden text-center py-20 bg-white rounded-[32px] border border-slate-100 shadow-soft max-w-lg mx-auto"
      >
        <div class="text-slate-300 text-5xl mb-4">🔍</div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">No articles found</h3>
        <p class="text-slate-500 text-sm">We couldn't find any articles matching your search query or tag selection.</p>
        <button 
          id="reset-filters-btn"
          class="mt-6 px-5 py-2.5 bg-brand-600 hover:bg-brand-700 text-white rounded-xl text-xs font-semibold shadow transition"
        >
          Reset Filters
        </button>
      </div>

    </div>
  </section>

  {/* Client Side Search / Filter Logic */}
  <script>
    // Selected elements
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
    const tagBtns = document.querySelectorAll('.tag-filter-btn');
    const cardsGrid = document.getElementById('blog-posts-grid');
    const cards = document.querySelectorAll('.blog-card') as NodeListOf<HTMLElement>;
    const emptyState = document.getElementById('empty-state');
    const resetBtn = document.getElementById('reset-filters-btn');

    let activeTag = 'all';
    let searchQuery = '';

    // Main render function
    function updateList() {
      let visibleCount = 0;
      
      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const description = card.getAttribute('data-description') || '';
        const tags = card.getAttribute('data-tags') || '';
        
        const matchesSearch = title.includes(searchQuery) || description.includes(searchQuery) || tags.includes(searchQuery);
        const matchesTag = activeTag === 'all' || tags.split(',').includes(activeTag);

        if (matchesSearch && matchesTag) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Show empty state if no matching items
      if (visibleCount === 0 && emptyState && cardsGrid) {
        emptyState.classList.remove('hidden');
        cardsGrid.classList.add('hidden');
      } else if (emptyState && cardsGrid) {
        emptyState.classList.add('hidden');
        cardsGrid.classList.remove('hidden');
      }
    }

    // Sort function
    function sortList() {
      if (!cardsGrid) return;
      const cardsArr = Array.from(cards);
      const sortVal = sortSelect ? sortSelect.value : 'newest';

      cardsArr.sort((a, b) => {
        if (sortVal === 'newest') {
          const dateA = parseInt(a.getAttribute('data-date') || '0');
          const dateB = parseInt(b.getAttribute('data-date') || '0');
          return dateB - dateA;
        } else if (sortVal === 'oldest') {
          const dateA = parseInt(a.getAttribute('data-date') || '0');
          const dateB = parseInt(b.getAttribute('data-date') || '0');
          return dateA - dateB;
        } else if (sortVal === 'seo') {
          const scoreA = parseInt(a.getAttribute('data-score') || '0');
          const scoreB = parseInt(b.getAttribute('data-score') || '0');
          return scoreB - scoreA;
        }
        return 0;
      });

      // Clear grid and append sorted
      cardsGrid.innerHTML = '';
      cardsArr.forEach(card => cardsGrid.appendChild(card));
    }

    // Event listeners
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        updateList();
      });
    }

    if (sortSelect) {
      sortSelect.addEventListener('change', () => {
        sortList();
      });
    }

    tagBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Toggle styling
        tagBtns.forEach(b => {
          b.classList.remove('bg-brand-600', 'text-white');
          b.classList.add('bg-slate-50', 'text-slate-700', 'hover:bg-slate-100', 'border-slate-200/50');
        });
        
        btn.classList.add('bg-brand-600', 'text-white');
        btn.classList.remove('bg-slate-50', 'text-slate-700', 'hover:bg-slate-100', 'border-slate-200/50');

        activeTag = btn.getAttribute('data-tag') || 'all';
        updateList();
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        activeTag = 'all';
        
        // Reset active tag button
        tagBtns.forEach(b => {
          const isAll = b.getAttribute('data-tag') === 'all';
          if (isAll) {
            b.classList.add('bg-brand-600', 'text-white');
            b.classList.remove('bg-slate-50', 'text-slate-700', 'hover:bg-slate-100');
          } else {
            b.classList.remove('bg-brand-600', 'text-white');
            b.classList.add('bg-slate-50', 'text-slate-700');
          }
        });

        if (sortSelect) sortSelect.value = 'newest';
        sortList();
        updateList();
      });
    }
  </script>
</Layout>
