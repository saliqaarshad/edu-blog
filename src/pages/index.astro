---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../utils/blog';

// Retrieve recent posts for the blog preview section
const posts = await getCollection('posts');
// Sort by pubDate descending, filter out any with noindex if desired (or just show recent ones)
const recentPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout 
  title="TheEduAssist - High Quality Education & Resources"
  description="Accelerate your knowledge with modern web engineering, SEO frameworks, and SaaS growth strategies. production-ready templates and resources."
>
  {/* Hero Section */}
  <section class="relative overflow-hidden py-20 sm:py-32 bg-gradient-to-b from-white via-brand-50/20 to-transparent">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-4xl mx-auto">
        <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-semibold bg-brand-100 text-brand-700 tracking-wide uppercase mb-6 shadow-sm">
          🚀 Next-Generation Education Platform
        </span>
        <h1 class="text-4xl sm:text-6xl font-extrabold text-slate-950 tracking-tight leading-none sm:leading-tight mb-8">
          The ultimate engine to scale your <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-600 to-indigo-500">technical expertise</span>
        </h1>
        <p class="text-lg sm:text-xl text-slate-600 leading-relaxed mb-10 max-w-2xl mx-auto">
          High-performance blogs, industry-standard guides, and interactive SEO blueprints crafted for modern developers, marketers, and SaaS teams.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a 
            href="/blog" 
            class="inline-flex items-center justify-center px-8 py-4 rounded-2xl text-base font-semibold bg-brand-600 text-white hover:bg-brand-700 transition duration-200 shadow-soft-lg shadow-brand-500/20 hover:shadow-brand-500/35 hover:-translate-y-0.5 active:translate-y-0"
          >
            Explore the Blog
          </a>
          <a 
            href="/about" 
            class="inline-flex items-center justify-center px-8 py-4 rounded-2xl text-base font-semibold bg-white text-slate-700 hover:bg-slate-50 border border-slate-200 transition duration-200 shadow-sm"
          >
            Learn More
          </a>
        </div>
      </div>
    </div>
    
    {/* Grid decoration background */}
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:14px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>
  </section>

  {/* Statistics Section */}
  <section class="py-12 bg-white border-y border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-4xl sm:text-5xl font-extrabold text-brand-600 tracking-tight">99.9%</div>
          <div class="text-xs sm:text-sm font-medium text-slate-500 uppercase tracking-wider mt-2">Platform Uptime</div>
        </div>
        <div>
          <div class="text-4xl sm:text-5xl font-extrabold text-brand-600 tracking-tight">10M+</div>
          <div class="text-xs sm:text-sm font-medium text-slate-500 uppercase tracking-wider mt-2">Monthly Impressions</div>
        </div>
        <div>
          <div class="text-4xl sm:text-5xl font-extrabold text-brand-600 tracking-tight">150k+</div>
          <div class="text-xs sm:text-sm font-medium text-slate-500 uppercase tracking-wider mt-2">Active Readers</div>
        </div>
        <div>
          <div class="text-4xl sm:text-5xl font-extrabold text-brand-600 tracking-tight">95+</div>
          <div class="text-xs sm:text-sm font-medium text-slate-500 uppercase tracking-wider mt-2">Average SEO Score</div>
        </div>
      </div>
    </div>
  </section>

  {/* Features Section */}
  <section class="py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-20">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight mb-4">
          Engineered for performance and clarity
        </h2>
        <p class="text-lg text-slate-600">
          We combined cutting-edge static rendering with headless content management to offer an unbeatable content hub.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        {/* Feature 1 */}
        <div class="bg-white p-8 rounded-3xl shadow-soft border border-slate-100/50 hover:shadow-soft-lg transition-all duration-300">
          <div class="w-12 h-12 rounded-2xl bg-brand-50 flex items-center justify-center text-brand-600 mb-6">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Lightning Fast Loading</h3>
          <p class="text-slate-600 leading-relaxed text-sm">
            Powered by Astro, delivering pre-rendered, completely flat HTML files with absolute zero JavaScript burden on your users.
          </p>
        </div>

        {/* Feature 2 */}
        <div class="bg-white p-8 rounded-3xl shadow-soft border border-slate-100/50 hover:shadow-soft-lg transition-all duration-300">
          <div class="w-12 h-12 rounded-2xl bg-brand-50 flex items-center justify-center text-brand-600 mb-6">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Inherent SEO Mastery</h3>
          <p class="text-slate-600 leading-relaxed text-sm">
            Every file includes automatic schema generation, robots configurations, meta definitions, canonical urls, and hreflangs.
          </p>
        </div>

        {/* Feature 3 */}
        <div class="bg-white p-8 rounded-3xl shadow-soft border border-slate-100/50 hover:shadow-soft-lg transition-all duration-300">
          <div class="w-12 h-12 rounded-2xl bg-brand-50 flex items-center justify-center text-brand-600 mb-6">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">PagesCMS Integration</h3>
          <p class="text-slate-600 leading-relaxed text-sm">
            Empower non-technical publishers to edit markdown metadata, CTAs, and FAQ questions in an elegant web portal that pushes directly to GitHub.
          </p>
        </div>

      </div>
    </div>
  </section>

  {/* Benefits Section */}
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 gap-16 items-center">
        
        {/* Left column */}
        <div class="mb-12 lg:mb-0">
          <span class="text-xs font-bold text-brand-600 uppercase tracking-widest bg-brand-50 px-3.5 py-1.5 rounded-full">
            Key Benefit
          </span>
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-950 tracking-tight mt-6 mb-8 leading-tight">
            Seamless publishing workflow for your entire marketing team
          </h2>
          <p class="text-lg text-slate-600 mb-6 leading-relaxed">
            Developers love standard Markdown files and GitHub-centric version control. Publishers love simple form fields and graphical text editors.
          </p>
          <p class="text-lg text-slate-600 mb-8 leading-relaxed">
            Our PagesCMS configuration matches Astro's Schema schema perfectly, meaning changes publish seamlessly without requiring developer intervention.
          </p>
          
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center mt-1">✓</div>
              <p class="text-sm font-semibold text-slate-800">Visual markdown preview for authors</p>
            </div>
            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center mt-1">✓</div>
              <p class="text-sm font-semibold text-slate-800">Automatic schema.org JSON-LD generation</p>
            </div>
            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center mt-1">✓</div>
              <p class="text-sm font-semibold text-slate-800">Instant deployments via Vercel Edge networks</p>
            </div>
          </div>
        </div>

        {/* Right column with visual styling placeholder */}
        <div class="relative bg-gradient-to-tr from-brand-600 to-indigo-500 p-8 rounded-3xl text-white shadow-soft-lg overflow-hidden">
          <div class="absolute inset-0 bg-white/5 backdrop-blur-3xl"></div>
          <div class="relative z-10">
            <div class="flex items-center gap-3 border-b border-white/20 pb-6 mb-6">
              <div class="w-3 h-3 rounded-full bg-red-400"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
              <div class="w-3 h-3 rounded-full bg-green-400"></div>
              <span class="text-xs text-white/60 font-mono ml-4">PagesCMS Interface</span>
            </div>
            
            <div class="space-y-4 font-mono text-xs">
              <div class="bg-slate-950/40 p-4 rounded-xl border border-white/10">
                <div class="text-white/40 mb-1">title:</div>
                <div class="text-white font-semibold">"The Essential Guide to SEO for SaaS Businesses"</div>
              </div>
              <div class="bg-slate-950/40 p-4 rounded-xl border border-white/10">
                <div class="text-white/40 mb-1">seoScore:</div>
                <div class="text-brand-300 font-bold">98</div>
              </div>
              <div class="bg-slate-950/40 p-4 rounded-xl border border-white/10">
                <div class="text-white/40 mb-1">faqs:</div>
                <div class="text-white/80 space-y-1">
                  <div>- question: "What is JSON-LD schema?"</div>
                  <div>  answer: "Structured data format for SEO..."</div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* Recent Blog Posts Section */}
  <section class="py-24 bg-slate-50 border-t border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-16">
        <div>
          <span class="text-xs font-bold text-brand-600 uppercase tracking-widest bg-brand-100 px-3.5 py-1.5 rounded-full">
            Knowledge Center
          </span>
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight mt-6">
            Latest insights from our blog
          </h2>
        </div>
        <a 
          href="/blog" 
          class="inline-flex items-center gap-1.5 text-brand-600 font-bold hover:text-brand-700 transition mt-4 sm:mt-0"
        >
          <span>View all articles</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {recentPosts.map((post) => {
          const readingTime = getReadingTime(post.body);
          return (
            <article class="bg-white rounded-3xl overflow-hidden border border-slate-100 shadow-soft hover:shadow-soft-lg transition duration-300 flex flex-col h-full">
              <div class="h-48 w-full bg-slate-200 relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/40 to-transparent z-10"></div>
                {/* Fallback pattern if images don't exist */}
                <div class="absolute inset-0 bg-gradient-to-tr from-brand-600/20 to-indigo-600/20"></div>
              </div>
              <div class="p-6 sm:p-8 flex flex-col flex-grow">
                <div class="flex items-center gap-2.5 text-xs text-slate-500 mb-4">
                  <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
                  <span>•</span>
                  <span>{readingTime} min read</span>
                </div>
                <h3 class="text-xl font-bold text-slate-950 line-clamp-2 hover:text-brand-600 transition mb-3">
                  <a href={`/blog/${post.slug}`}>{post.data.title}</a>
                </h3>
                <p class="text-sm text-slate-600 line-clamp-3 leading-relaxed mb-6 flex-grow">
                  {post.data.description}
                </p>
                <div class="flex items-center justify-between pt-6 border-t border-slate-50 mt-auto">
                  <span class="text-xs font-semibold text-slate-700">By {post.data.author}</span>
                  <a 
                    href={`/blog/${post.slug}`} 
                    class="text-xs font-bold text-brand-600 hover:text-brand-700 transition"
                  >
                    Read Article &rarr;
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

    </div>
  </section>

  {/* Testimonials Placeholder Section */}
  <section class="py-24 bg-white border-t border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl font-bold text-slate-950">Loved by teams around the globe</h2>
        <p class="text-slate-600 mt-3">Here is how high-performance content changes the game.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        {/* Testimonial 1 */}
        <div class="bg-slate-50 p-8 sm:p-10 rounded-3xl border border-slate-100">
          <p class="text-slate-600 italic leading-relaxed mb-6">
            "Migrating our content infrastructure to Astro + PagesCMS has halved our website loading times and doubled our search rankings. Our editors could start publishing instantly without code."
          </p>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-brand-200 flex items-center justify-center font-bold text-brand-700">
              AM
            </div>
            <div>
              <h4 class="text-sm font-bold text-slate-900">Amanda Miller</h4>
              <p class="text-xs text-slate-500">VP of Marketing, TechSpace</p>
            </div>
          </div>
        </div>

        {/* Testimonial 2 */}
        <div class="bg-slate-50 p-8 sm:p-10 rounded-3xl border border-slate-100">
          <p class="text-slate-600 italic leading-relaxed mb-6">
            "SEO configurations can be fragile. Having structured frontmatter directly in PagesCMS with built-in noindex checks and XML generation eliminates technical mistakes entirely."
          </p>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-indigo-200 flex items-center justify-center font-bold text-indigo-700">
              DB
            </div>
            <div>
              <h4 class="text-sm font-bold text-slate-900">David Brody</h4>
              <p class="text-xs text-slate-500">Head of SEO, GrowthSaaS</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* Final CTA Section */}
  <section class="py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-tr from-brand-600 to-indigo-600 rounded-[32px] p-8 sm:p-16 text-white text-center shadow-soft-lg relative overflow-hidden">
        <div class="relative z-10 max-w-2xl mx-auto">
          <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-6">
            Ready to deploy your modern content engine?
          </h2>
          <p class="text-white/80 leading-relaxed mb-10 text-base sm:text-lg">
            Get the full template with integrated PagesCMS layouts, Vercel ready builds, and auto-generated Schema schemas today.
          </p>
          <div class="flex flex-col sm:flex-row justify-center gap-4">
            <a 
              href="/blog" 
              class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-white text-brand-700 font-bold hover:bg-slate-50 transition"
            >
              Get Started Now
            </a>
            <a 
              href="/about" 
              class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-brand-700/40 text-white font-semibold hover:bg-brand-700/60 transition border border-white/10"
            >
              Contact Support
            </a>
          </div>
        </div>
        {/* Background circular decoration */}
        <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-brand-500/20 blur-3xl"></div>
        <div class="absolute -bottom-24 -right-24 w-96 h-96 rounded-full bg-indigo-500/20 blur-3xl"></div>
      </div>
    </div>
  </section>
</Layout>


